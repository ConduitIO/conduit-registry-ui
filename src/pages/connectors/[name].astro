---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { VerifiedBadge } from '../../components/VerifiedBadge';
import SignatureNote, { SIGNATURE_NOTE_ID } from '../../components/SignatureNote.astro';
import { EffectiveStatusTag } from '../../components/EffectiveStatusTag';
import { RevocationBanner } from '../../components/RevocationBanner';
import { CopyInstallButton } from '../../components/CopyInstallButton';
import { CompatCell } from '../../components/CompatCell';
import DeclaredMinimaNote from '../../components/DeclaredMinimaNote.astro';
import { loadRenderModel } from '../../lib/loadRenderModel';
import { sortVersionsDescending } from '../../lib/semver';
import { installGateFor, type InstallGate } from '../../lib/verdicts';

export function getStaticPaths() {
  const model = loadRenderModel();
  return model.connectors.map((c) => ({ params: { name: c.name }, props: { connector: c } }));
}

const { connector } = Astro.props;
const versionsNewestFirst = sortVersionsDescending(connector.versions, (v) => v.version);
const defaultVersion = versionsNewestFirst.find((v) => v.isDefault) ?? versionsNewestFirst[0];
const installCommand = `conduit connectors install ${connector.name}`;
---

<BaseLayout
  title={`${connector.displayName} — Conduit connector registry`}
  description={connector.description}
>
  <header>
    <h1>
      {connector.displayName}
      <code>{connector.name}</code>
    </h1>
    <p>
      {
        defaultVersion && (
          <VerifiedBadge
            verdict={defaultVersion.verdict}
            {...(defaultVersion.verdictReason !== undefined
              ? { reason: defaultVersion.verdictReason }
              : {})}
            {...(defaultVersion.verdictCheckedAt !== undefined
              ? { checkedAt: defaultVersion.verdictCheckedAt }
              : {})}
            descriptionId={SIGNATURE_NOTE_ID}
          />
        )
      }
      <EffectiveStatusTag status={connector.effectiveStatus} />
    </p>
    <SignatureNote />
    {
      connector.repository && (
        <p>
          <a href={connector.repository} target="_blank" rel="noopener noreferrer">
            Source repository
          </a>
        </p>
      )
    }
    <p>{connector.description}</p>
  </header>

  {
    connector.effectiveStatus === 'revoked' && connector.revoked && (
      <RevocationBanner severity="revoked" reason={connector.revoked.reason} />
    )
  }
  {
    connector.effectiveStatus === 'yanked' && !connector.revoked && (
      <RevocationBanner
        severity="yanked"
        reason={
          versionsNewestFirst
            .map((v) => v.yanked?.reason)
            .filter((r): r is string => Boolean(r))
            .join(' ') || 'All published versions of this connector have been yanked.'
        }
      />
    )
  }

  <section aria-labelledby="install-heading">
    <h2 id="install-heading">Install</h2>
    {
      (() => {
        // WS4 4.13: a version the CLI would refuse to install never gets an
        // active install command — a failed verification verdict (the command
        // would install exactly the bytes the build proved tampered or
        // misattributed), or a no-provenance not_attempted (the CLI
        // hard-refuses versions without provenance — RequireProvenance).
        const gate: InstallGate = installGateFor({
          suppressInstallCommand: connector.suppressInstallCommand,
          verdict: defaultVersion?.verdict,
          verdictReason: defaultVersion?.verdictReason,
          version: defaultVersion?.version,
        });
        switch (gate.gate) {
          case 'suppress':
            return (
              <p>
                Install is disabled for this connector — see the notice above. Do not attempt to
                install it manually until the status changes.
              </p>
            );
          case 'fail':
            return (
              <p data-install-gated="fail">
                Install is disabled for version <code>{gate.version}</code>: its signature
                verification failed at build time ({gate.reason ?? 'unknown reason'}). Do not
                install this version.
              </p>
            );
          case 'no-provenance':
            return (
              <p data-install-gated="no-provenance">
                Install is disabled for version <code>{gate.version}</code>: the index declares no
                SLSA provenance for it, and the conduit CLI refuses to install versions without
                provenance. Publish a provenance bundle for this version (or fix the index) before
                installing.
              </p>
            );
          case 'none':
            return <CopyInstallButton command={installCommand} client:load />;
        }
      })()
    }
  </section>

  <section aria-labelledby="versions-heading">
    <h2 id="versions-heading">Versions</h2>
    <DeclaredMinimaNote />
    <table>
      <caption class="visually-hidden"
        >Published versions of {connector.displayName}, newest first</caption
      >
      <thead>
        <tr>
          <th scope="col">Version</th>
          <th scope="col">Released</th>
          <th scope="col">Min Conduit</th>
          <th scope="col">Min protocol</th>
          <th scope="col">Status</th>
          <th scope="col">Signature</th>
        </tr>
      </thead>
      <tbody>
        {
          versionsNewestFirst.map((v) => (
            <tr data-yanked={Boolean(v.yanked)}>
              <th scope="row">
                <code>{v.version}</code>
              </th>
              <td>{v.releasedAt ? new Date(v.releasedAt).toISOString().slice(0, 10) : '—'}</td>
              <td>
                <code>{v.minConduitVersion}</code>
              </td>
              <td>
                <code>{v.minProtocolVersion}</code>
              </td>
              <td>
                {v.yanked ? (
                  <details>
                    <summary>Yanked</summary>
                    <p>{v.yanked.reason}</p>
                  </details>
                ) : v.deprecated ? (
                  <EffectiveStatusTag status="deprecated" />
                ) : (
                  'Active'
                )}
              </td>
              <td>
                <VerifiedBadge
                  verdict={v.verdict}
                  {...(v.verdictReason !== undefined ? { reason: v.verdictReason } : {})}
                  {...(v.verdictCheckedAt !== undefined ? { checkedAt: v.verdictCheckedAt } : {})}
                  descriptionId={SIGNATURE_NOTE_ID}
                />
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  {
    defaultVersion && (
      <section aria-labelledby="compat-heading">
        <h2 id="compat-heading">Platform compatibility — {defaultVersion.version}</h2>
        <table>
          <caption>
            OS / architecture support for version {defaultVersion.version}. Every cell is either
            "Available" or "Not available" — never blank.
          </caption>
          <thead>
            <tr>
              <th scope="col">OS \ Arch</th>
              {Array.from(new Set(defaultVersion.compat.map((c) => c.arch))).map((arch) => (
                <th scope="col">{arch}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {Array.from(new Set(defaultVersion.compat.map((c) => c.os))).map((os) => (
              <tr>
                <th scope="row">{os}</th>
                {defaultVersion.compat
                  .filter((c) => c.os === os)
                  .map((c) => (
                    <CompatCell
                      os={c.os}
                      arch={c.arch}
                      available={c.available}
                      {...(connector.repository
                        ? { requestUrl: `${connector.repository}/issues` }
                        : {})}
                    />
                  ))}
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )
  }

  {
    // WS4 amended AC 4.7: NO Downloads section — there is no real download-
    // stats source provisioned (no Scarf token), so the section is absent
    // rather than rendered as permanently "unavailable" (an empty shelf would
    // imply a data source exists when none does). The merge plumbing
    // (src/lib/scarfStats.ts + scripts/fetchScarfStats.ts) stays as the
    // wiring for when a real source exists; the AC's dist-level check is
    // `grep -c "Downloads" dist/` = 0, enforced by the integration test.
  }
</BaseLayout>
